# Copier vers .env (ignoré par git) à la racine du projet et renseigner les valeurs.
# Lu par Vite au build (variables VITE_*) et par le serveur Express au démarrage.

# --- Frontend : intégrées au bundle, donc publiques ---
# Clé anon uniquement : lecture seule, colonnes limitées par les GRANT Supabase.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
# Lien vers le Google Sheets source (partagé en lecture) ; le bouton est masqué si vide.
VITE_GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/<sheet-id>/edit

# --- Serveur uniquement : ne JAMAIS préfixer par VITE_ ---
# Clé service_role : utilisée par POST /api/resolve-anomaly pour lire l'anomalie à vérifier.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Webhook n8n « Verify Anomaly Resolution » : vérifie la correction dans le Google Sheets
# avant de marquer l'anomalie résolue. Le secret est la valeur du credential Header Auth
# (en-tête X-Verify-Secret) associé au nœud Webhook.
N8N_VERIFY_WEBHOOK_URL=https://<instance-n8n>/webhook/verify-anomaly
N8N_VERIFY_SECRET=<secret-partage>
# Port d'écoute du serveur, sur 127.0.0.1 uniquement (Caddy relaie le trafic HTTPS).
PORT=3000
