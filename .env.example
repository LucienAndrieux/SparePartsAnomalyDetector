# Copier vers .env (ignoré par git) à la racine du projet et renseigner les valeurs.
# Lu par Vite au build (variables VITE_*) et par le serveur Express au démarrage.

# --- Frontend : intégrées au bundle, donc publiques ---
# Clé anon uniquement : lecture seule, colonnes limitées par les GRANT Supabase.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# --- Serveur uniquement : ne JAMAIS préfixer par VITE_ ---
# Clé service_role : utilisée par POST /api/resolve-anomaly pour écrire en base.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Port d'écoute du serveur, sur 127.0.0.1 uniquement (Caddy relaie le trafic HTTPS).
PORT=3000
